{
  "name": "@sverse/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt build --preset=cloudflare_pages",
    "build:node": "nuxt build --preset=node-server",
    "preview": "wrangler --cwd dist pages dev",
    "deploy": "wrangler --cwd dist pages deploy",
    "deploy:build": "npm run build && npm run deploy",
    "check": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "3.17.7",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue-tsc": "2.2.12",
    "wrangler": "4.118.0"
  }
}
