        "deploy:build": "npm run build && npm run deploy",
        "check": "nuxt typecheck"
    },
    "dependencies": {
        "nuxt": "4.4.8",
        "vue": "3.5.40",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "typescript": "5.9.3",
        "vue-tsc": "2.2.12",
        "wrangler": "4.118.0"
    }
}