{
    "name": "@sverse/frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nuxt dev --port 3000",
        "build": "nuxt build",
        "build:node": "nuxt build --preset=node-server",
        "preview": "wrangler pages dev dist",
